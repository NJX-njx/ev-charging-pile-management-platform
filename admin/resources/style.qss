/* 管理端样式表，色值与规则以 docs/visual-design.md 为准 */

QWidget#page {
    background: #F5F6F7;
}

QDialog, QMessageBox {
    background: #FFFFFF;
}

/* 左侧导航：浅色底 + 主色选中指示条，色值取自 docs/visual-design.md 色板 */
QListWidget#listWidgetNav {
    background: #FFFFFF;
    border: none;
    border-right: 1px solid #E0E3E6;
    outline: none;
    font-size: 14px;
}
QListWidget#listWidgetNav::item {
    color: #1F2329;
    padding: 8px 12px;
    border-left: 4px solid transparent;
}
QListWidget#listWidgetNav::item:selected {
    background: #E3F6EF;
    color: #00875C;
    border-left: 4px solid #00A870;
}
QListWidget#listWidgetNav::item:hover:!selected {
    background: #F5F6F7;
}

/* 指标卡：白底圆角 */
QFrame#card {
    background: #FFFFFF;
    border: 1px solid #E0E3E6;
    border-radius: 8px;
}

/* 次按钮（默认） */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #E0E3E6;
    border-radius: 6px;
    color: #1F2329;
    padding: 5px 14px;
    min-height: 22px;
}
QPushButton:hover {
    border-color: #00A870;
}
QPushButton:disabled {
    background: #F5F6F7;
    color: #9CA3AF;
}

/* 站点表格行内操作按钮：紧凑内边距 + 最小宽度，保证「修改」「删除」文字完整 */
QWidget#stationRowOps QPushButton {
    padding: 4px 10px;
    min-width: 48px;
}

/* 主按钮（动态属性 primary=true） */
QPushButton[primary="true"] {
    background: #00A870;
    border: none;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton[primary="true"]:hover {
    background: #00875C;
}
QPushButton[primary="true"]:disabled {
    background: #A7DCC9;
}

/* 输入控件 */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: #FFFFFF;
    border: 1px solid #E0E3E6;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #00A870;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border-color: #00A870;
}

/* 表格 */
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E0E3E6;
    gridline-color: #E0E3E6;
    alternate-background-color: #FAFBFC;
    selection-background-color: #E3F6EF;
    selection-color: #1F2329;
}
QHeaderView::section {
    background: #F0F2F4;
    border: none;
    border-bottom: 1px solid #E0E3E6;
    /* 右侧留白供 FilterTable 的排序箭头与筛选漏斗图标（未挂组件的表头仅多空白） */
    padding: 6px 30px 6px 6px;
    color: #1F2329;
    font-weight: bold;
}

/* 登录窗口 */
QWidget#LoginWindow {
    background: #F5F6F7;
}

/* 详情对话框分组标题 */
QLabel#sectionTitle {
    color: #6B7280;
    font-weight: bold;
}
